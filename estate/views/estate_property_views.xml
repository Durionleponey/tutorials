<?xml version="1.0"?>
<odoo>
    <record id="real_estate_model_action" model="ir.actions.act_window"><!-- wat will show up -->
        <field name="name">All property</field>
        <field name="res_model">estate.property</field><!-- wat model ? -->
        <field name="view_mode">list,form</field><!-- order-->
        <field name="help" type="html">
          <p>
            Hello html !
          </p><p>
            Add more estates with the "new" button !
          </p><p>
          </p>
        </field>
    </record>



    <record id="estate_property_view_form" model="ir.ui.view">


        <field name="name">estate.property.form</field>
        <field name="model">estate.property</field>
        <field name="arch" type="xml">
            <form string="Real Estate">
                <header>
                    <button name="action_replace_name_by_pomme_de_terre" type="object" string="Do Something"/>
                    <button name="action_replace_name_by_random_coaster_name" type="object" string="Replace with random name of coaster"/>
                    <button name="action_set_as_sold" type="object" string="set as sold"/>
                    <button name="action_set_as_cancel" type="object" string="set as cancel"/>
                </header>

                <sheet>
                    <group>
                        <h1>
                            <field name="name"/>
                            <field name="tags_ids" widget="many2many_tags"/>
                        </h1>
                    </group>
                    <group>
                        <group>
                            <field name="state"/>
                            <field name="type_id"/>
                            <field name="postcode"/>
                            <field name="date_availability"/>
                        </group>

                        <group>
                            <field name="expected_price"/>
                            <field name="selling_price"/>
                            <field name="total_space"/>
                            <field name="max_offer"/>
                            <field name="max_offer_but_with_mapped"/>
                            <filed name="status"/>
                        </group>

                    </group>
                    <notebook>
                        <page string="Description">
                            <group>
                                <field string="Description" name="description"/>
                                <field name="bedrooms"/>
                                <field name="living_area"/>
                                <field name="facades"/>
                                <field name="garden"/>
                                <field name="garden_area"/>
                                <field name="garden_orientation"/>
                                <field name="active"/>
                                <field name="postcode"/>
                             </group>

                        </page>

                        <page string="Offers">
                            <group>
                                <field name="offer_ids">
                                <list>
                                    <field name="name"/>
                                    <field name="partner_id"/>
                                    <field name="status"/>
                                    <field name="create_date"/>
                                    <field name="validity"/>
                                    <field name="date_deadline"/>
                                </list>
                                </field>
                             </group>
                        </page>

                        <page string="More Stuff">
                            <group>
                                <field name="buyer_id"/>
                                <field name="saleperson_id"/>
                             </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>




    <record id="estate_property_views_list" model="ir.ui.view">
        <field name="name">estate.property.views.list</field>
        <field name="model">estate.property</field>
        <field name="arch" type="xml">
            <list string="Name">
                <header>
                    <button name="action_replace_name_by_pomme_de_terre" type="object" string="Replace name with pomme de terre"/>
                    <button name="action_replace_name_by_random_coaster_name" type="object" string="Replace with random name of coaster"/>
                    <button name="action_set_as_sold" type="object" string="set as sold"/>
                    <button name="action_set_as_cancel" type="object" string="set as cancel"/>


                </header>
                <field name="name" string="name"/>
                <field name="state"/>
                <field name="postcode" string="postcode"/>
                <field name="bedrooms" string="bedrooms"/>
                <field name="living_area"/>
                <field name="expected_price"/>
                <field name="selling_price"/>
                <field name="date_availability"/>
            </list>
        </field>
    </record>



        <record id="estate_property_search" model="ir.ui.view">
            <field name="name">estate.property.views.search</field>
            <field name="model">estate.property</field>
            <field name="arch" type="xml">
                <search string="Tests">
                    <field name="name" string="Title" /><!-- search bar proposition to search in this cat-->
                    <field name="postcode"/>
                    <field name="expected_price"/>
                    <field name="bedrooms"/>
                    <field name="living_area"/>
                    <field name="facades"/>

                <filter string="1300?" name="postcode_filter" domain="[('postcode', '=', 1300)]"/><!-- filter -->
                <filter string="Active" name="active_filter" domain="[('active', '=', True)]"/>
                <filter string="No Active" name="no_active_filter" domain="[('active', '=', False)]"/>

                <filter string="Postcode" name="group_by_postcode" context="{'group_by': 'postcode'}"/><!-- group by -->
                <filter string="Active" name="group_by_active" context="{'group_by': 'active'}"/>


                </search>
            </field>
    </record>





</odoo>


