<?xml version="1.0"?>
<odoo>
    <record id="real_estate_type_model_action" model="ir.actions.act_window">
        <field name="name">Property Type</field>
        <field name="res_model">estate.property.type</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
          <p>
            Hello html !
          </p><p>
            Add more estates type with the "new" button !
          </p><p>
          </p>
        </field>
    </record>


    <record id="estate_property_type_views_list" model="ir.ui.view">
        <field name="name">estate.property.type.views.list</field>
        <field name="model">estate.property.type</field>
        <field name="arch" type="xml">
            <list string="Type">
                <field name="sequence" widget="handle"/>
                <field name="id" string="identifiant"/>
                <field name="name" string="name"/>
            </list>
        </field>
    </record>







    <record id="estate_property_type_views_form" model="ir.ui.view">


        <field name="name">estate.property.type.views.form</field>
        <field name="model">estate.property.type</field>
        <field name="arch" type="xml">
            <form string="Real Estate">
                <header>
                </header>

                <sheet>
                    <group>
                        <h1>
                            <field name="name"/>
                        </h1>
                    </group>

                    <notebook>
                        <page string="Properties">
                            <group>

                                <field name="property_ids">
                                    <list>
                                        <field name="name"/>
                                        <field name="expected_price"/>
                                        <field name="state"/>
                                    </list>
                                </field>


                             </group>

                        </page>

                    </notebook>
                </sheet>
            </form>
        </field>
    </record>






</odoo>


